exports[`styled selection and help layout at 120 columns: help layout 120 1`] = `
"┌─ Help · keys: jjui ─────────────────────────────────────────────────────────────────────────────┐
│Keyboard reference · jjui preset                                                                 │
│Switch: --keys jjui|legacy, JJ_EVOLVED_KEYS, keybindings.json                                    │
│┌─ Keyboard reference ──────────────────────────────────────────────────────────────────────────┐│
││Navigate                                                                                     ▀ ││
││j/down / k/up     Move through revisions                                                       ││
││Tab               Switch focus between the revisions and the preview                           ││
││@ / [ / ]         Jump to the working copy / parent / child; choose when there are several     ││
││^O                Return from a temporary reveal to the previous view                          ││
││^L                Load 200 more revisions, keeping the selection                               ││
││^R                Refresh history now; external changes also refresh automatically             ││
││?                 Show this help                                                               ││
││^E                Show the last error in full; Esc or d returns to the diff                    ││
││q / Ctrl-C        Quit                                                                         ││
││                                                                                               ││
││Preview pane                                                                                   ││
││p                 Hide or show the preview; the graph expands when hidden                      ││
││PgUp / PgDn       Scroll the preview by page                                                   ││
││^P / ^N           Scroll the preview by line, keeping graph focus                              ││
││^U / ^D           Scroll the preview by half page                                              ││
││d                 Show the selected revision's diff                                            ││
││                                                                                               ││
│└───────────────────────────────────────────────────────────────────────────────────────────────┘│
│Esc/? close  j/k scroll  PgUp/PgDn page                                                          │
│                                                                                                 │
└─────────────────────────────────────────────────────────────────────────────────────────────────┘"
`;

